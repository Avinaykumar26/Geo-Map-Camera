{
  "name": "Geo Map Camera",
  "short_name": "GeoCamera",
  "description": "Capture photos with GPS coordinates, timestamp, address and a map snapshot burned in. No login, no upload — everything stays on your device.",
  "id": "/",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#070b10",
  "theme_color": "#070b10",
  "lang": "en",
  "categories": ["photo", "utilities", "productivity", "travel"],
  "icons": [
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Take a geotagged photo",
      "short_name": "Capture",
      "url": "./?capture=1",
      "description": "Open the camera straight away"
    }
  ]
}
